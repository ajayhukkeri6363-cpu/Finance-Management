# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Runtime environment ("development" or "production")
NODE_ENV="development"
PORT=3000

# Session signing secret (generate a long random string in production, e.g., openssl rand -hex 32)
SESSION_SECRET="REPLACE_WITH_SECURE_RANDOM_HEX_SECRET"

# Optional one-time token to allow creating the initial admin via API/UI when 0 admins exist
FIRST_ADMIN_SETUP_TOKEN="REPLACE_WITH_ONE_TIME_SETUP_TOKEN"

# MySQL 8 Database Configuration (required in production; optional in local development)
MYSQL_HOST="127.0.0.1"
MYSQL_PORT=3306
MYSQL_USER="govtrack_user"
MYSQL_PASSWORD="REPLACE_WITH_MYSQL_PASSWORD"
MYSQL_DATABASE="govtrack_ai"
MYSQL_SSL="false"
